{
  // Must match the Worker name in your Cloudflare dashboard.
  "name": "hiddenstategroup1",
  "compatibility_date": "2026-08-16",

  // The Worker handles /api/* and hands everything else to the static site.
  "main": "worker/index.js",

  "assets": {
    // Where `npm run build` puts the finished site.
    "directory": "./dist/",

    // Serves index.html for any unmatched path, so React Router handles
    // /records, /artists/1 etc. — this is what stops a refresh 404-ing.
    "not_found_handling": "single-page-application",

    // Lets the Worker fall through to the files via env.ASSETS.
    "binding": "ASSETS",

    /*
      THIS LINE IS WHY THE API APPEARED TO BE MISSING.

      By default the asset layer answers first. Combined with the
      single-page-application fallback above, a request for /api/anything was
      being handed index.html before the Worker ever ran — so a browser got
      the website's 404 page while curl, which does not ask for HTML, fell
      through to the Worker and worked.

      run_worker_first sends these paths to the Worker before assets are
      considered.
    */
    "run_worker_first": ["/api/*"]
  },

  /*
    Runs the day-before reminder. 09:00 UTC is late morning in Romania —
    early enough to be useful, not so early it arrives overnight.
  */
  "triggers": {
    "crons": [
      // The day-before reminder.
      "0 9 * * *",
      // The weekly backup. 04:00 Monday UTC — nothing is happening, and if it
      // fails there is a whole week to notice before the next one.
      "0 4 * * 1",
      // The health check. Seventeen minutes past, rather than on the hour,
      // so it is not queued behind everyone else's hourly jobs.
      "17 * * * *"
    ]
  },

  /*
    Photo storage. Create a bucket called hidden-state-media in the Cloudflare
    dashboard under R2, and this connects to it. Uploaded images are served
    back through the Worker at /media/..., so nothing needs a public bucket
    URL and the files stay behind your own domain.
  */
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hidden-state-media"
    }
  ],

  // The D1 database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiddenstate",
      "database_id": "027625da-d133-4ff3-b289-5bf3aae07e09"
    }
  ]
}
